<UserControl x:Class="GCS.Views.AIAssistantTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#161B22">

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="75"/>

            <!-- Chat -->
            <RowDefinition Height="*"/>

            <!-- Input -->
            <RowDefinition Height="70"/>

            <!-- Bottom Buttons -->
            <RowDefinition Height="65"/>

        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- HEADER -->
        <!-- ======================================================= -->

        <Border Grid.Row="0"
                Margin="10"
                CornerRadius="8"
                Background="#1F2633">

            <Grid Margin="20,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="🤖 AI Flight Assistant"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Aircraft Intelligence Platform"
                               FontSize="12"
                               Foreground="#A0A0A0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#00D26A"
                             VerticalAlignment="Center"/>

                    <TextBlock Margin="8,0,0,0"
                               Text="Online"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ======================================================= -->
        <!-- CHAT AREA -->
        <!-- ======================================================= -->

        <Border Grid.Row="1"
        Margin="10,0,10,10"
        Background="#1F2633"
        CornerRadius="8">

            <Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ListBox ItemsSource="{Binding Conversation}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="15">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Margin="0,0,0,15"
                                Padding="15"
                                Background="#2A3441"
                                CornerRadius="10"
                                MaxWidth="850">

                                    <StackPanel>

                                        <DockPanel>

                                            <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="#00D26A"
                                            Margin="0,0,10,0">

                                                <TextBlock Text="🤖"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="White"/>
                                                 

                                            </Border>

                                            <StackPanel>

                                                <TextBlock Text="AI Flight Assistant"
           FontWeight="Bold"
           FontSize="15"
           Foreground="White"/>

                                                <TextBlock
    Margin="0,15,0,0"
    Text="Welcome to AI Flight Assistant"
    FontSize="14"
    Foreground="White"
    TextWrapping="Wrap"/>

                                            </StackPanel>

                                        </DockPanel>

                                        <TextBlock Margin="0,15,0,0"
                                           Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="White"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </ScrollViewer>

            </Grid>

        </Border>

        <Border Margin="0,0,0,15"
                                        Padding="15"
                                        CornerRadius="10"
                                        Background="#2A3441"
                                        MaxWidth="850"
                                        HorizontalAlignment="Stretch">

            
                <StackPanel>

                    <!-- Header -->

                    <DockPanel>

                        <Border Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="#00D26A"
                                                    Margin="0,0,10,0">

                            <TextBlock
                                                    Text="{Binding Avatar}"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel>

                            <TextBlock
                                                    Text="{Binding Sender}"
                                                    FontWeight="Bold"
                                                    FontSize="14"
                                                    Foreground="White"/>

                            <TextBlock
                                                    Text="{Binding Time}"
                                                    FontSize="10"
                                                    Foreground="#909090"/>

                        </StackPanel>

                    </DockPanel>

                    <!-- Message -->

                    <TextBlock
                                            Margin="0,15,0,0"
                                            Text="{Binding Text}"
                                            FontSize="14"
                                            Foreground="White"
                                            TextWrapping="Wrap"/>

                </StackPanel>

            </Border>



    <!-- ===================================================== -->
    <!-- MESSAGE INPUT -->
    <!-- ===================================================== -->

    <Border Grid.Row="2"
                Margin="10,0,10,10"
                Background="#1F2633"
                CornerRadius="8">

        <Grid Margin="10">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="110"/>

            </Grid.ColumnDefinitions>

            <TextBox
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    Background="#2A3441"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15,10"
                    Text="{Binding UserMessage, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Type your message..." />

            <Button
                    Grid.Column="1"
                    Content="Send"
                    FontWeight="Bold"
                    FontSize="14"
                    Background="#00D26A"
                    Foreground="White"
                    BorderThickness="0"
                    Command="{Binding SendMessageCommand}"/>

        </Grid>

    </Border>
    <!-- ===================================================== -->
    <!-- QUICK ACTIONS -->
    <!-- ===================================================== -->

    <Border Grid.Row="3"
                Margin="10,0,10,10"
                Background="#1F2633"
                CornerRadius="8">

        <Grid Margin="10">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

            </Grid.ColumnDefinitions>

            <!-- Analyze Aircraft -->

            <Button Grid.Column="0"
                        Margin="5"
                        Height="42"
                        Background="#00C853"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Command="{Binding AnalyzeAircraftCommand}">

                <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                    <TextBlock Text="✈"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>

                    <TextBlock Text="Analyze Aircraft"/>

                </StackPanel>

            </Button>

            <!-- Parameter Assistant -->

            <Button Grid.Column="1"
                        Margin="5"
                        Height="42"
                        Background="#1976D2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Command="{Binding ParameterAnalysisCommand}">

                <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                    <TextBlock Text="⚙"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>

                    <TextBlock Text="Parameters"/>

                </StackPanel>

            </Button>

            <!-- Log Analysis -->

            <Button Grid.Column="2"
                        Margin="5"
                        Height="42"
                        Background="#FB8C00"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Command="{Binding LogAnalysisCommand}">

                <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                    <TextBlock Text="📄"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>

                    <TextBlock Text="Log Analysis"/>

                </StackPanel>

            </Button>

            <!-- Swarm -->

            <Button Grid.Column="3"
                        Margin="5"
                        Height="42"
                        Background="#8E24AA"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Command="{Binding SwarmAICommand}">

                <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                    <TextBlock Text="🛸"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>

                    <TextBlock Text="Swarm AI"/>

                </StackPanel>

            </Button>

        </Grid>

    </Border>

    </Grid>
</UserControl>